{
  "bundle": "SubunitNotch.app",
  "executable": "SubunitNotch",
  "identifier": "co.subunit.notch",
  "entitlements": [
    "com.apple.security.automation.apple-events",
    "com.apple.security.device.audio-input",
    "com.apple.security.device.camera"
  ],
  "code": [
    {
      "path": "Contents/Resources/mediaremote-adapter/MediaRemoteAdapter.framework",
      "identifier": "com.vandenbe.MediaRemoteAdapter",
      "binary": "Versions/A/MediaRemoteAdapter"
    },
    {
      "path": "Contents/Helpers/SubunitAgentBridge",
      "identifier": "co.subunit.notch.agent-bridge"
    },
    {
      "path": "Contents/Applications/Notch-Zentrale.app",
      "identifier": "co.subunit.notch.zentrale",
      "binary": "Contents/MacOS/NotchZentrale",
      "when": "zentrale"
    }
  ]
}
